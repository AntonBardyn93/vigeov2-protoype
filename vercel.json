{
  "buildCommand": "true",
  "outputDirectory": "share",
  "framework": null,
  "cleanUrls": false,
  "functions": {
    "api/auth/*.js": {
      "includeFiles": "allowed-emails.txt"
    },
    "middleware.js": {
      "includeFiles": "allowed-emails.txt"
    }
  },
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
